{
	"schemaVersion": 1,
	"id": "equipmisc",
	"version": "${version}",
	"name": "EquipMisc",
	"description": "Miscellaneous expansions to midgame equipment",
	"authors": [
		"ThePotatoArchivist"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/equipmisc",
		"sources": "https://github.com/ThePotatoArchivist/EquipMisc/"
	},
	"license": "MIT",
	"icon": "assets/equipmisc/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "archives.tater.equipmisc.EquipMisc"
		],
		"client": [
			"archives.tater.equipmisc.client.EquipMiscClient"
		],
		"rrv_client": [
			"archives.tater.equipmisc.client.rrv.EquipMiscClientIntegration"
		]
	},
	"mixins": [
		"equipmisc.mixins.json",
