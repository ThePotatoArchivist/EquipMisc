			"config": "equipmisc.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"lootinj": "^1.0.5"
	},
	"suggests": {
		"another-mod": "*"
	}
